{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CF-Stats-TGBot Configuration",
  "description": "Multi-site unified telemetry and Telegram console configuration. Store your actual config in config.json (gitignored).",
  "d1": {
    "database_name": "stats",
    "database_id": "YOUR_CLOUDFLARE_D1_DATABASE_UUID"
  },
  "telegram": {
    "bot_token": "YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER",
    "admin_chat_id": "YOUR_NUMERIC_TELEGRAM_USER_ID",
    "webhook_secret": "YOUR_RANDOM_SECRET_TOKEN_FOR_WEBHOOK"
  },
  "master_site": {
    "domain": "your-master-site.example.com",
    "webhook_path": "/api/telegram-webhook"
  },
  "defaults": {
    "log_retention_days": 30,
    "environment": "production"
  }
}
